  "version": "0.1.0",
  "repository": "https://github.com/laikacms/decap-cms/tree/v4.beta/packages/decap-cms-lib-pat",
  "bugs": "https://github.com/laikacms/decap-cms/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "src/",
    "dist/"
  ],
  "license": "MIT",
  "keywords": [
    "decap-cms",
    "auth",
    "pat"
  ],
  "sideEffects": false,
  "scripts": {
