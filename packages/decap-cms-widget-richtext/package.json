{
  "name": "decap-cms-widget-richtext",
  "description": "Rich text (Plate-based) widget for Decap CMS.",
  "version": "3.8.0",
  "homepage": "https://www.decapcms.org/docs/widgets/",
  "repository": "https://github.com/decaporg/decap-cms/tree/main/packages/decap-cms-widget-richtext",
  "bugs": "https://github.com/decaporg/decap-cms/issues",
  "license": "MIT",
  "keywords": [
    "decap-cms",
    "widget",
    "richtext",
    "editor"
  ],
  "sideEffects": false,
  "scripts": {
    "develop": "tsc --build --watch",
    "build": "tsc --build",
    "clean": "rimraf dist"
  },
  "type": "module",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "peerDependencies": {
    "@emotion/react": "catalog:emotion",
    "@emotion/styled": "catalog:emotion",
    "decap-cms-ui-default": "workspace:*",
    "lodash": "catalog:utils",
    "prop-types": "^15.8.1",
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "dependencies": {
    "@platejs/basic-nodes": "^49.0.0",
    "@platejs/link": "^50.2.7",
    "@platejs/list": "^50.2.0",
    "@platejs/list-classic": "^49.1.0",
    "class-variance-authority": "^0.7.0",
    "dompurify": "^3.4.0",
    "lucide-react": "^0.331.0",
    "mdast-util-definitions": "^1.2.3",
    "mdast-util-to-string": "^2.0.0",
    "platejs": "^49.2.21",
    "rehype-parse": "^6.0.0",
    "rehype-remark": "^8.0.0",
    "rehype-remove-comments": "^4.0.2",
    "rehype-stringify": "^7.0.0",
    "remark-parse": "^6.0.3",
    "remark-rehype": "^4.0.0",
    "remark-slate": "^1.8.6",
    "remark-slate-transformer": "^0.7.4",
    "remark-stringify": "^6.0.4",
    "slate": "^0.118.1",
    "unified": "^9.0.0",
    "unist-builder": "^1.0.3",
    "unist-util-visit-parents": "^2.0.1"
  },
  "devDependencies": {
    "@types/react": "catalog:types"
  }
}
