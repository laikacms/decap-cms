{
  "name": "decap-cms-widget-richtext",
  "description": "Widget for editing richtext in Decap CMS.",
  "version": "3.1.0",
  "homepage": "https://www.decapcms.org/docs/widgets/#richtext",
  "repository": "https://github.com/decaporg/decap-cms/tree/master/packages/decap-cms-widget-richtext",
  "bugs": "https://github.com/decaporg/decap-cms/issues",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "license": "MIT",
  "keywords": [
    "decap-cms",
    "widget",
    "richtext",
    "editor"
  ],
  "sideEffects": false,
  "scripts": {
    "develop": "tsc --build --watch",
    "build": "tsc --build",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@platejs/basic-nodes": "catalog:plate",
    "dompurify": "catalog:markdown",
    "@platejs/link": "catalog:plate",
    "@platejs/list": "catalog:plate",
    "@platejs/list-classic": "catalog:plate",
    "class-variance-authority": "catalog:plate",
    "lucide-react": "catalog:plate",
    "platejs": "catalog:plate",
    "rehype-parse": "catalog:markdown",
    "rehype-remark": "catalog:markdown",
    "rehype-stringify": "catalog:markdown",
    "remark-parse": "catalog:markdown",
    "remark-rehype": "catalog:markdown",
    "remark-slate": "catalog:markdown",
    "remark-slate-transformer": "catalog:markdown",
    "remark-stringify": "catalog:markdown",
    "unified": "catalog:markdown"
  },
  "peerDependencies": {
    "@emotion/react": "catalog:emotion",
    "@emotion/styled": "catalog:emotion",
    "decap-cms-ui-default": "workspace:*",
    "immutable": "catalog:utils",
    "lodash": "catalog:utils",
    "prop-types": "catalog:react",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "react-immutable-proptypes": "catalog:react"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src"
  ]
}
