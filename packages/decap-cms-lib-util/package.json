{
  "name": "decap-cms-lib-util",
  "description": "Shared utilities for Decap CMS.",
  "version": "3.5.0",
  "repository": "https://github.com/decaporg/decap-cms/tree/main/packages/decap-cms-lib-util",
  "bugs": "https://github.com/decaporg/decap-cms/issues",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "keywords": [
    "decap-cms"
  ],
  "sideEffects": false,
  "scripts": {
    "develop": "tsc --build --watch",
    "build": "tsc --build",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "js-sha256": "catalog:utils"
  },
  "peerDependencies": {
    "lodash": "catalog:utils"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./types/cms": {
      "types": "./dist/types/cms/index.d.ts",
      "import": "./dist/types/cms/index.js",
      "default": "./dist/types/cms/index.js"
    }
  }
}
