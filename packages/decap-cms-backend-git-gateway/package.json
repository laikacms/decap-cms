{
  "name": "decap-cms-backend-git-gateway",
  "description": "Git Gateway backend for Decap CMS",
  "version": "3.6.0",
  "repository": "https://github.com/decaporg/decap-cms/tree/main/packages/decap-cms-backend-git-gateway",
  "bugs": "https://github.com/decaporg/decap-cms/issues",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "license": "MIT",
  "keywords": [
    "decap-cms",
    "backend",
    "git-gateway",
    "gateway"
  ],
  "sideEffects": false,
  "scripts": {
    "develop": "tsc --build --watch",
    "build": "tsc --build",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "gotrue-js": "catalog:auth",
    "ini": "catalog:utils",
    "jwt-decode": "catalog:auth",
    "minimatch": "catalog:utils"
  },
  "devDependencies": {
    "@types/react": "catalog:types"
  },
  "peerDependencies": {
    "@emotion/react": "catalog:emotion",
    "@emotion/styled": "catalog:emotion",
    "decap-cms-backend-bitbucket": "workspace:*",
    "decap-cms-backend-github": "workspace:*",
    "decap-cms-backend-gitlab": "workspace:*",
    "decap-cms-lib-auth": "workspace:*",
    "decap-cms-lib-util": "workspace:*",
    "decap-cms-ui-auth": "workspace:*",
    "decap-cms-ui-default": "workspace:*",
    "lodash": "catalog:utils",
    "react": "catalog:react"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src"
  ]
}
