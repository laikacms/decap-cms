{
  "name": "@laikacms/decap-cms",
  "version": "4.0.4-alpha.0",
  "description": "Single-package fork of Decap CMS v4.beta. Same components as the original monorepo, exposed through one package with subpath exports. Root export is the decap-cms-app bootstrap. See RESTRUCTURE.md.",
  "license": "MIT",
  "author": "Sem Postma <sem@laikacms.com> (based on Decap CMS by Netlify and contributors)",
  "homepage": "https://github.com/laikacms/decap-cms",
  "repository": {
    "type": "git",
    "url": "https://github.com/laikacms/decap-cms.git"
  },
  "bugs": {
    "url": "https://github.com/laikacms/decap-cms/issues"
  },
  "keywords": [
    "cms",
    "decap",
    "laikacms",
    "headless-cms",
    "content-management",
    "git-based-cms",
    "jamstack"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && pnpm copy:assets",
    "analyze": "node ./scripts/analyze.mjs",
    "prepack": "pnpm build",
    "build:demo": "vite build --config vite.config.demo.ts",
    "build:demo-graphql": "vite build --config vite.config.demo-graphql.ts",
    "build:laika-demo": "vite build --config vite.config.laika-demo.ts",
    "build:laika-bare-demo": "vite build --config vite.config.laika-bare-demo.ts",
    "build:dev-test": "pnpm build:demo && pnpm build:laika-demo && pnpm build:laika-bare-demo",
    "serve:dev-test": "npx --yes serve dev-test -l 5174",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "dev": "vite build --config vite.config.demo.ts && vite build --config vite.config.laika-demo.ts && vite build --config vite.config.laika-bare-demo.ts && (vite build --config vite.config.demo.ts --watch & BUILD_PID=$!; trap 'kill $BUILD_PID 2>/dev/null' EXIT INT TERM; npx --yes serve dev-test -l 5174)",
    "dev:lib": "pnpm copy:assets && (tsc-alias -p tsconfig.build.json --watch & tsc -p tsconfig.build.json --watch)",
    "copy:assets": "mkdir -p dist/widgets/code/data && cp src/widgets/code/data/languages.json dist/widgets/code/data/languages.json",
    "typecheck": "tsc --noEmit && tsc -p playwright --noEmit && tsc -p .storybook --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint --color \"src/**/*.{ts,tsx,js,mjs}\"",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "clean": "rimraf dist .turbo"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Opera versions",
    "last 2 Firefox versions",
    "last 2 Edge versions",
    "last 2 Safari versions",
    "last 2 iOS versions",
    "last 2 ChromeAndroid versions"
  ],
