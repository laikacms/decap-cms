    "./dist/laika-app/index.js",
    "./dist/dev-server/**",
    "./src/app/index.ts",
    "./src/laika-app/index.ts",
    "./src/dev-server/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app/index.js",
      "default": "./dist/app/index.js"
    },
    "./app": {
