{
  "name": "decap-cms-lib-widgets",
  "description": "Shared utilities for Decap CMS.",
  "version": "3.3.0",
  "repository": "https://github.com/decaporg/decap-cms/tree/main/packages/decap-cms-lib-widgets",
  "bugs": "https://github.com/decaporg/decap-cms/issues",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "license": "MIT",
  "keywords": [
    "decap-cms"
  ],
  "sideEffects": false,
  "scripts": {
    "develop": "tsc --build --watch",
    "build": "tsc --build",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "dayjs": "catalog:utils",
    "decap-cms-lib-util": "workspace:*"
  },
  "peerDependencies": {
    "immutable": "catalog:utils",
    "lodash": "catalog:utils"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src"
  ]
}
