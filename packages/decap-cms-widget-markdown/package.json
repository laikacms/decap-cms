{
  "name": "decap-cms-widget-markdown",
  "description": "Widget for editing markdown in Decap CMS.",
  "version": "3.7.0",
  "homepage": "https://www.decapcms.org/docs/widgets/#markdown",
  "repository": "https://github.com/decaporg/decap-cms/tree/main/packages/decap-cms-widget-markdown",
  "bugs": "https://github.com/decaporg/decap-cms/issues",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "license": "MIT",
  "keywords": [
    "decap-cms",
    "widget",
    "markdown",
    "editor"
  ],
  "sideEffects": false,
  "scripts": {
    "develop": "tsc --build --watch",
    "build": "tsc --build",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "detab": "catalog:markdown",
    "dompurify": "catalog:markdown",
    "is-hotkey": "catalog:markdown",
    "is-url": "catalog:markdown",
    "mdast-util-definitions": "catalog:markdown",
    "mdast-util-to-string": "catalog:markdown",
    "rehype-parse": "catalog:markdown",
    "rehype-remark": "catalog:markdown",
    "rehype-stringify": "catalog:markdown",
    "remark-parse": "catalog:markdown",
    "remark-rehype": "catalog:markdown",
    "remark-slate": "catalog:markdown",
    "remark-slate-transformer": "catalog:markdown",
    "remark-stringify": "catalog:markdown",
    "slate": "catalog:slate",
    "slate-base64-serializer": "catalog:slate",
    "slate-dom": "catalog:slate",
    "slate-history": "catalog:slate",
    "slate-hyperscript": "catalog:slate",
    "slate-plain-serializer": "catalog:slate",
    "slate-react": "catalog:slate",
    "slate-soft-break": "catalog:slate",
    "unified": "catalog:markdown",
    "unist-builder": "catalog:markdown",
    "unist-util-visit-parents": "catalog:markdown",
    "vfile-location": "catalog:markdown"
  },
  "peerDependencies": {
    "@emotion/react": "catalog:emotion",
    "@emotion/styled": "catalog:emotion",
    "decap-cms-ui-default": "workspace:*",
    "immutable": "catalog:utils",
    "lodash": "catalog:utils",
    "prop-types": "catalog:react",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "react-immutable-proptypes": "catalog:react"
  },
  "devDependencies": {
    "commonmark": "catalog:vitest",
    "commonmark-spec": "catalog:vitest"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src"
  ]
}
