{
  "name": "decap-cms-app",
  "description": "An extensible, open source, Git-based, React CMS for static sites. Reusable congiuration with React as peer.",
  "version": "3.11.0",
  "homepage": "https://www.decapcms.org",
  "repository": "https://github.com/decaporg/decap-cms/tree/main/packages/decap-cms-app",
  "bugs": "https://github.com/decaporg/decap-cms/issues",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "src"
  ],
  "types": "./dist/index.d.ts",
  "scripts": {
    "develop": "tsc --build --watch",
    "build": "tsc --build",
    "clean": "rimraf dist"
  },
  "keywords": [
    "cms",
    "content editing",
    "static site generators",
    "jamstack"
  ],
  "license": "MIT",
  "excluded.dependencies": {
    "decap-cms-backend-azure": "workspace:*",
    "decap-cms-backend-aws-cognito-github-proxy": "workspace:*",
    "decap-cms-backend-bitbucket": "workspace:*",
    "decap-cms-backend-git-gateway": "workspace:*",
    "decap-cms-backend-gitea": "workspace:*",
    "decap-cms-backend-github": "workspace:*",
    "decap-cms-backend-gitlab": "workspace:*",
    "decap-cms-widget-markdown": "workspace:*",
    "decap-cms-widget-richtext": "workspace:*"
  },
  "dependencies": {
    "@emotion/react": "catalog:emotion",
    "@emotion/styled": "catalog:emotion",
    "ajv": "catalog:validation",
    "ajv-errors": "catalog:validation",
    "ajv-keywords": "catalog:validation",
    "codemirror": "catalog:codemirror",
    "dayjs": "catalog:utils",
    "decap-cms-backend-proxy": "workspace:*",
    "decap-cms-backend-test": "workspace:*",
    "decap-cms-core": "workspace:*",
    "decap-cms-editor-component-image": "workspace:*",
    "decap-cms-lib-auth": "workspace:*",
    "decap-cms-lib-util": "workspace:*",
    "decap-cms-lib-widgets": "workspace:*",
    "decap-cms-locales": "workspace:*",
    "decap-cms-ui-auth": "workspace:*",
    "decap-cms-ui-default": "workspace:*",
    "decap-cms-widget-boolean": "workspace:*",
    "decap-cms-widget-code": "workspace:*",
    "decap-cms-widget-colorstring": "workspace:*",
    "decap-cms-widget-datetime": "workspace:*",
    "decap-cms-widget-file": "workspace:*",
    "decap-cms-widget-image": "workspace:*",
    "decap-cms-widget-list": "workspace:*",
    "decap-cms-widget-map": "workspace:*",
    "decap-cms-widget-number": "workspace:*",
    "decap-cms-widget-object": "workspace:*",
    "decap-cms-widget-relation": "workspace:*",
    "decap-cms-widget-select": "workspace:*",
    "decap-cms-widget-string": "workspace:*",
    "decap-cms-widget-text": "workspace:*",
    "immutable": "catalog:utils",
    "lodash": "catalog:utils",
    "prop-types": "catalog:react",
    "react-immutable-proptypes": "catalog:react",
    "uuid": "catalog:utils"
  },
  "devDependencies": {
    "@types/react": "catalog:types"
  },
  "peerDependencies": {
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "incrementToForceBump": 2,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  }
}
