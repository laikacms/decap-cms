{
  "name": "decap-server",
  "description": "Proxy server to be used with Decap CMS proxy backend",
  "version": "3.6.0",
  "repository": "https://github.com/decaporg/decap-cms/tree/main/packages/decap-server",
  "bugs": "https://github.com/decaporg/decap-cms/issues",
  "license": "MIT",
  "main": "./dist/index.js",
  "keywords": [
    "decap-cms",
    "backend"
  ],
  "sideEffects": false,
  "scripts": {
    "develop": "tsc --build --watch",
    "build": "tsc --build",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@hapi/joi": "catalog:validation",
    "async-mutex": "catalog:utils",
    "cors": "catalog:server",
    "dotenv": "catalog:build",
    "express": "catalog:server",
    "morgan": "catalog:server",
    "simple-git": "catalog:git",
    "what-the-diff": "catalog:utils",
    "winston": "catalog:server"
  },
  "devDependencies": {
    "@types/cors": "catalog:types",
    "@types/express": "catalog:types",
    "@types/hapi__joi": "catalog:types",
    "@types/morgan": "catalog:types",
    "@types/node": "catalog:types",
    "@types/vfile-message": "catalog:types",
    "decap-cms-lib-util": "workspace:*",
    "nodemon": "catalog:build",
    "ts-node": "catalog:build"
  },
  "engines": {
    "node": ">=v10.22.1"
  },
  "bin": {
    "decap-server": "./dist/index.js"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src"
  ]
}
