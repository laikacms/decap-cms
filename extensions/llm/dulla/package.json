{
  "name": "@laikacms/decap-cms-llm-dulla",
  "description": "Dulla: the Laika LLM transport for Decap CMS. Implements the CMS's LlmTransport against @laikacms/server/ai, and executes the document tools client-side.",
  "version": "4.2.0",
  "repository": "https://github.com/laikacms/decap-cms/tree/main/extensions/llm/dulla",
  "bugs": "https://github.com/laikacms/decap-cms/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "dist/"
  ],
  "license": "MIT",
  "keywords": [
    "decap-cms",
    "ai",
    "llm",
    "laika"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --color \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "ai": "catalog:"
  },
  "peerDependencies": {
    "@laikacms/decap-cms": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@laikacms/decap-cms": "workspace:*",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
