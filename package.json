{
  "private": true,
  "description": "Workspace root for the laikacms/decap-cms repo. The published package lives in packages/decap-cms; this root only carries repo-wide tooling (formatting, git hooks, commit linting) and delegates everything else. See restructure.md for why the repo is laid out this way.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/laikacms/decap-cms.git"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "test:watch": "pnpm --filter @laikacms/decap-cms run test:watch",
    "test:ci": "node scripts/check-readme-layout.mjs && node scripts/check-contributing-typecheck-count.mjs && pnpm -r run test:ci",
    "test:e2e": "pnpm --filter @laikacms/decap-cms run test:e2e",
    "dev": "pnpm --filter @laikacms/decap-cms run dev",
    "dev:lib": "pnpm --filter @laikacms/decap-cms run dev:lib",
    "build:demo": "pnpm --filter @laikacms/decap-cms run build:demo",
    "build:dev-test": "pnpm --filter @laikacms/decap-cms run build:dev-test",
    "serve:dev-test": "pnpm --filter @laikacms/decap-cms run serve:dev-test",
    "analyze": "pnpm --filter @laikacms/decap-cms run analyze",
    "storybook": "pnpm --filter @laikacms/decap-cms run storybook",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/assert-release-branch.mjs && changeset publish",
    "clean": "rimraf --glob 'packages/*/dist' 'packages/*/.turbo' '**/node_modules'",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "dprint": "catalog:",
    "husky": "catalog:",
    "rimraf": "catalog:"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24 <25"
  }
}
