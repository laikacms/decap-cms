{
  "name": "decap-cms-monorepo",
  "version": "4.0.0",
  "description": "A CMS for static site generators. Give users a simple way to edit and add content to any site built with a static site generator.",
  "private": true,
  "license": "MIT",
  "author": "Decap CMS <decapcms@pm.me>",
  "homepage": "https://decapcms.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/decaporg/decap-cms.git"
  },
  "bugs": {
    "url": "https://github.com/decaporg/decap-cms/issues"
  },
  "keywords": [
    "cms",
    "decap",
    "netlify",
    "static-site-generator",
    "headless-cms",
    "content-management",
    "git-based-cms",
    "jamstack"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "pnpm run develop",
    "develop": "turbo run develop --parallel --filter=!decap-server",
    "build": "turbo run build",
    "build:demo": "vite build --config vite.config.demo.ts",
    "type-check": "tsc --noEmit",
    "type-check:watch": "pnpm run type-check -- --watch",
    "clean": "rimraf \"packages/*/dist\" dev-test/dist \"packages/*/node_modules\" \".turbo\"",
    "reset": "pnpm run clean",
    "test": "pnpm run lint && pnpm run type-check && pnpm run test:unit",
    "test:all": "pnpm run test && pnpm run test:e2e",
    "test:ci": "pnpm run lint-quiet && pnpm run type-check && pnpm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "pnpm run build:demo && pnpm run test:e2e:run",
    "test:e2e:ci": "pnpm run build:demo && pnpm run test:e2e:run-ci",
    "test:e2e:dev": "start-test develop 8080 test:e2e:exec-dev",
    "test:e2e:serve": "http-server -c-1 dev-test",
    "test:e2e:exec": "cypress run --browser chrome --headless",
    "test:e2e:exec-ci": "node cypress/run.mjs",
    "test:e2e:exec-dev": "cypress open",
    "test:e2e:record-fixtures:dev": "HTTP_PROXY=http://localhost:1080 RECORD_FIXTURES=true cypress open",
    "test:e2e:run": "start-test test:e2e:serve 8080 test:e2e:exec",
    "test:e2e:run-ci": "start-test test:e2e:serve 8080 test:e2e:exec-ci",
    "mock:server:start": "node -e 'require(\"./cypress/utils/mock-server\").start()'",
    "mock:server:stop": "node -e 'require(\"./cypress/utils/mock-server\").stop()'",
    "lint": "run-p -c --aggregate-output \"lint:*\"",
    "lint-quiet": "run-p -c --aggregate-output \"lint:* --quiet\"",
    "lint:css": "stylelint --ignore-path .gitignore \"packages/**/*.{css,scss,ts,tsx}\"",
    "lint:js": "eslint --color \"packages/**/*.{ts,tsx,js,mjs}\" \"scripts/**/*.{ts,tsx,mjs,js}\" \"cypress/**/*.{ts,tsx,js,mjs}\"",
    "lint:format": "prettier \"packages/**/*.{ts,tsx,css,js,mjs}\" \"scripts/**/*.{ts,tsx,mjs,js}\" --list-different",
    "format": "pnpm run lint:js --fix --quiet && pnpm run format:prettier --write",
    "format:prettier": "prettier \"packages/**/*.{ts,tsx,css}\" \"scripts/**/*.{ts,tsx,mjs,js}\"",
    "lerna:publish": "lerna publish from-package --yes --no-private",
    "prepare": "husky install",
    "test:package-integrity": "node scripts/test-package-integrity.mjs"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Opera versions",
    "last 2 Firefox versions",
    "last 2 Edge versions",
    "last 2 Safari versions",
    "last 2 iOS versions",
    "last 2 ChromeAndroid versions"
  ],
  "devDependencies": {
    "@commitlint/cli": "catalog:commitlint",
    "@commitlint/config-conventional": "catalog:commitlint",
    "@cypress/webpack-preprocessor": "^7.1.0",
    "@emotion/babel-plugin": "catalog:emotion",
    "@emotion/eslint-plugin": "catalog:emotion",
    "@eslint/js": "catalog:eslint",
    "@octokit/rest": "catalog:git",
    "@octokit/types": "catalog:git",
    "@simonsmith/cypress-image-snapshot": "catalog:cypress",
    "@storybook/addon-actions": "catalog:storybook",
    "@storybook/addon-links": "catalog:storybook",
    "@storybook/react": "catalog:storybook",
    "@stylelint/postcss-css-in-js": "catalog:stylelint",
    "@testing-library/dom": "catalog:vitest",
    "@testing-library/jest-dom": "catalog:vitest",
    "@testing-library/react": "catalog:vitest",
    "@types/common-tags": "^1.8.4",
    "@types/hast": "^3.0.4",
    "@types/jscodeshift": "^17.3.0",
    "@types/jwt-decode": "catalog:types",
    "@types/lodash": "catalog:types",
    "@types/node": "^25.6.0",
    "@types/uuid": "catalog:types",
    "@vitejs/plugin-react": "catalog:vite",
    "@vitest/coverage-v8": "catalog:vitest",
    "ajv": "catalog:validation",
    "all-contributors-cli": "catalog:build",
    "buffer": "catalog:polyfills",
    "common-tags": "catalog:utils",
    "cross-env": "catalog:build",
    "cypress": "catalog:cypress",
    "cypress-plugin-tab": "catalog:cypress",
    "dotenv": "catalog:build",
    "eslint": "catalog:eslint",
    "eslint-config-prettier": "catalog:eslint",
    "eslint-import-resolver-exports": "catalog:eslint",
    "eslint-import-resolver-typescript": "catalog:eslint",
    "eslint-plugin-cypress": "catalog:eslint",
    "eslint-plugin-import": "catalog:eslint",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react": "catalog:eslint",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "catalog:eslint",
    "execa": "catalog:build",
    "gitlab": "catalog:git",
    "globals": "catalog:build",
    "globby": "catalog:build",
    "http-server": "catalog:build",
    "husky": "catalog:build",
    "jscodeshift": "^17.3.0",
    "jsdom": "catalog:vitest",
    "lerna": "catalog:build",
    "mockserver-client": "catalog:cypress",
    "mockserver-node": "catalog:cypress",
    "ncp": "catalog:build",
    "nock": "catalog:cypress",
    "node-fetch": "catalog:utils",
    "npm-run-all": "catalog:build",
    "path-browserify": "catalog:polyfills",
    "postcss": "catalog:postcss",
    "postcss-scss": "catalog:postcss",
    "postcss-styled-syntax": "catalog:postcss",
    "prettier": "catalog:build",
    "process": "catalog:polyfills",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "rehype": "catalog:utils",
    "rimraf": "catalog:build",
    "simple-git": "catalog:git",
    "start-server-and-test": "catalog:build",
    "stream-browserify": "catalog:polyfills",
    "stylelint": "catalog:stylelint",
    "stylelint-config-standard-scss": "catalog:stylelint",
    "ts-loader": "^9.5.7",
    "turbo": "catalog:build",
    "typescript": "catalog:build",
    "typescript-eslint": "catalog:eslint",
    "unist-util-visit": "catalog:utils",
    "vite": "catalog:vite",
    "vite-plugin-dts": "catalog:vite",
    "vitest": "catalog:vitest"
  },
  "dependencies": {
    "ajv": "catalog:validation",
    "ajv-errors": "catalog:validation",
    "ajv-keywords": "catalog:validation",
    "yaml": "catalog:utils"
  },
  "resolutions": {
    "react-redux": "^7.2.0",
    "clean-stack": "5.2.0"
  },
  "overrides": {
    "clean-stack": "5.2.0"
  },
  "packageManager": "pnpm@9.15.9"
}
