{
  "compilerOptions": {
    "declaration": true,
    "jsx": "react",
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "noEmit": true,
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["**/src/**/*"],
  "exclude": ["node_modules"]
}
