exports[`Sidebar > should render nested collection with filterTerm 1`] = `
<DocumentFragment>
  <aside
    class="css-mpd3gk"
  >
    <h2
      class="css-kyaebm"
    >
      collection.sidebar.collections
    </h2>
    <collection-search
      collections="[object Object]"
      searchterm=""
    />
    <ul
      class="css-nxqw53"
    >
      <li>
        <nested-collection
          collection="[object Object]"
          data-testid="posts"
          filterterm="dir1/dir2"
        />
      </li>
    </ul>
  </aside>
</DocumentFragment>
`;

